# Build output
/build/
/bin/
/obj/
*.exe
*.dll
*.pdb
*.ilk
*.lib
*.exp
*/build/
*/*/build/

# Visual Studio / Premake generated
.vs/
*.sln
*.vcxproj
*.vcxproj.*
*.user
Makefile
*.make

# Game files — NEVER commit copyrighted assets or binaries
/game/
*.ff
*.pak
*.xpak
*.iwd

# Publisher / LPC data. Activision's, obtained per-machine by a user who owns the game, and
# redistributable by nobody — see the project's legal guardrails. The fastfiles are already covered
# by *.ff, but the manifest and auth token that travel with them are not, so the whole tree is
# excluded by name rather than by extension.
/tools/LPC/
.manifest
auth.lsg

# Generated by premake (generate-buildinfo) — do not commit
common/version.hpp

# Python tooling
__pycache__/
*.pyc

# Runtime output the mod writes next to the game exe (dvars.txt, lua_tree.txt, ...)
/cw-mod/
bocw_dump.bin
host_launch_block.bin
client_join_args.txt

# User-specific local paths
tools/game/directories.json
scripts/.gamepath

# OS / editor
Thumbs.db
Desktop.ini
.idea/
*.swp

# dwserver runtime logs
tools/dwserver/*.log
